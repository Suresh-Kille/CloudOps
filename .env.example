# CloudOps System Environment Variables
PROJECT_NAME="CloudOps: Intelligent Cloud Infrastructure Monitoring and Automated DevOps"
VERSION="1.0.0"
ENVIRONMENT="development"

# Security
SECRET_KEY="cloudops-super-secure-production-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./cloudops.db"
# For PostgreSQL in Docker:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/cloudops"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="cloudops"

# Monitoring & Self-Healing
ANOMALY_THRESHOLD=0.65
MAX_RECOVERY_RETRIES=3
RECOVERY_COOLDOWN_SECONDS=120
